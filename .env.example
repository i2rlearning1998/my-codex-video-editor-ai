# P2-R2: every key and setting, as named placeholders. Copy to .env.local
# (browser build values) and to the server's environment (server values).
# Never commit real values. docs/KEYS.md says what each one unlocks.

# Real accounts and cloud projects in the panel, website and editor (.env.local (browser build))
VITE_SUPABASE_URL=

# Same as VITE_SUPABASE_URL (the public anon key, safe in the browser) (.env.local (browser build))
VITE_SUPABASE_ANON_KEY=

# The Continue with Google button (.env.local (browser build), optional)
VITE_GOOGLE_CLIENT_ID=

# The panel uses the gateway server (real models, server credits) (.env.local (browser build))
VITE_GATEWAY_URL=

# The server stores credits, usage and settings in Supabase (server environment)
SUPABASE_URL=

# Same as SUPABASE_URL (writes the ledger and usage) (server environment only (never the browser))
SUPABASE_SERVICE_ROLE_KEY=

# The server accepts Supabase sign-ins (AUTH_MODE=supabase) (server environment (or SUPABASE_JWKS_URL))
SUPABASE_JWT_SECRET=

# Same, with the project's public keys (server environment (instead of SUPABASE_JWT_SECRET))
SUPABASE_JWKS_URL=

# Claude models (Director, Write) (server environment only)
ANTHROPIC_API_KEY=

# GPT models and OpenAI images (Images, Thumbnail, AI image scenes) (server environment only)
OPENAI_API_KEY=

# Gemini models (server environment only)
GEMINI_API_KEY=

# Grok models (server environment only)
XAI_API_KEY=

# ElevenLabs voices (Studio › Voice, voice-over scenes) (server environment only)
ELEVENLABS_API_KEY=

# AI video scenes through a video-job service (server environment only (plus the provider's address in Admin))
VIDEO_JOBS_API_KEY=

# supabase for real sign-ins; local for tests and offline (server environment)
AUTH_MODE=

# Local test sign-ins; never on a public server (server environment (local mode only))
LOCAL_AUTH_SECRET=

# Which sites may call the server (server environment)
SERVER_ORIGINS=

# P3 server only; never expose in browser builds
RAZORPAY_KEY_ID=

# P3 server only; never expose in browser builds
RAZORPAY_KEY_SECRET=

# P3 server only; never expose in browser builds
RAZORPAY_WEBHOOK_SECRET=

# P3 server only; never expose in browser builds
STRIPE_SECRET_KEY=

# P3 server only; never expose in browser builds
STRIPE_WEBHOOK_SECRET=

# P3 server only; never expose in browser builds
PAYPAL_CLIENT_ID=

# P3 server only; never expose in browser builds
PAYPAL_CLIENT_SECRET=

# P3 server only; never expose in browser builds
PAYPAL_WEBHOOK_ID=

# P3 server only; never expose in browser builds
ENTITLEMENT_SECRET=

# P3 server only; never expose in browser builds
KEY_VAULT_SECRET=
