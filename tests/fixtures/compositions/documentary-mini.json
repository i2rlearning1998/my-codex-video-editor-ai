          { "id": "chapter-title", "name": "Chapter title", "kind": "text", "start": 0.5, "duration": 4, "text": "1. The hive", "width": 680, "height": 70, "transform": { "x": 100, "y": 910 }, "fontSize": 48, "fill": "#f4efe6" }
