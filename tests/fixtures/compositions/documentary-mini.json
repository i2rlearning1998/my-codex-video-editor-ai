          { "id": "question", "name": "Question", "kind": "text", "start": 1, "duration": 4, "text": "Where does honey come from?", "width": 1400, "height": 120, "transform": { "x": 260, "y": 860 }, "fill": "#f4efe6" },
          { "id": "bed", "name": "Music bed", "kind": "audio-slot", "slot": "music", "start": 0, "duration": 5 }
