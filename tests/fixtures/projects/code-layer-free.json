          "code": {
            "tier": "C",
            "source": "// A Tier C test animation that takes about 40 ms per frame (to watch and\n// cancel a bake). Seekable: any frame is a pure function of t.\nexport default {\n  meta: {\n    id: 'slow-bar',\n    name: 'Slow bar',\n    version: '1.0.0',\n    category: 'Test',\n    duration: 3,\n    seekable: true,\n    keepFrame: false,\n    thumbnailTime: 1.5,\n    libs: [],\n    params: [{ name: 'color', label: 'Colour', type: 'color', default: '#3366ff' }],\n  },\n  init({ ctx, params, size }) {\n    this.ctx = ctx;\n    this.params = params;\n    this.size = size;\n  },\n  renderFrame({ t }) {\n    const until = performance.now() + 40;\n    while (performance.now() < until) {\n      // Busy: a heavy frame.\n    }\n    const { ctx, params, size } = this;\n    ctx.fillStyle = params.color;\n    ctx.fillRect(0, size.height * 0.4, (size.width * t) / 3, size.height * 0.2);\n  },\n};\n",
            "meta": {
              "id": "slow-bar",
              "name": "Slow bar",
              "version": "1.0.0",
              "category": "Test",
              "duration": 3,
              "seekable": true,
              "keepFrame": false,
