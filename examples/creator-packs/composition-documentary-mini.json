{
  "format": "creator-pack",
  "version": 1,
  "pack": {
    "id": "doc-mini",
    "name": {
      "en": "Documentary mini"
    },
    "version": 1,
    "author": "ai",
    "createdWith": "claude-chat"
  },
  "items": [
    {
      "id": "style-documentary",
      "name": {
        "en": "Calm documentary",
        "hi": "\u0936\u093e\u0902\u0924 \u0921\u0949\u0915\u094d\u092f\u0942\u092e\u0947\u0902\u091f\u094d\u0930\u0940"
      },
      "tags": ["documentary", "story", "calm"],
      "type": "style",
      "data": {
        "category": "documentary",
        "description": "A patient, factual story told through real footage, archive pictures and a steady voice-over. The viewer should finish knowing one thing clearly, not ten things vaguely.",
        "brief": {
          "mood": "Thoughtful, honest and warm; curious rather than dramatic.",
          "pacing": "Slow and even: shots of 4 to 7 seconds, cuts on the end of a spoken sentence, a 1 second breath after each chapter. Never cut faster than 2 seconds.",
          "structure": [
            "Cold open: one striking image and one sentence that poses the question (0-10 s)",
            "Title card on a quiet background",
            "Three chapters, each opened by a short lower-third chapter title",
            "Each chapter: establishing shot, detail shots, one fact on screen",
            "Closing: return to the opening image, answer the question in one sentence",
            "End card with credits and sources as on-screen text"
          ],
          "doNot": [
            "No whooshes, flashes, glitches or zoom punches",
            "No more than one on-screen text line at a time",
            "No stock music with vocals under the voice-over",
            "Never invent statistics; leave a [FACT?] placeholder text instead",
            "No colour-shifting or VHS effects"
          ],
          "qualityBar": "Every text on screen is readable for at least 3 seconds; the voice-over is never covered by music; every chapter answers part of the opening question."
        },
        "look": {
          "palette": {
            "background": "#f4efe6",
            "primary": "#2f3e46",
            "accent": "#b5651d",
            "text": "#1b1b1b"
          },
          "fonts": {
            "heading": "Poppins",
            "body": "Inter"
          },
          "motion": "calm"
        },
        "kit": {
          "preferLibrary": [
            {
              "id": "starter/lower-third",
              "optional": true
            }
          ],
          "presets": ["fade", "slide", "ken-burns"],
          "transitions": [
            "transition.cross-blur",
            {
              "id": "transition.dip-to-black",
              "optional": true
            }
          ],
          "effects": ["effect.slow-zoom", "effect.filmic"]
        },
        "inputs": {
          "accepts": ["topic", "script", "audio", "video", "reference"]
        },
        "assetPolicy": {
          "order": ["library", "stock", "ai"],
          "aiImagesMax": 0,
          "aiVideosMax": 0
        },
        "output": {
          "aspect": "16:9",
          "fps": 25,
          "durationHint": "3-8 minutes"
        },
        "defaultFreedom": "guided"
      }
    },
    {
