{
  "format": "creator-pack",
  "version": 1,
  "pack": {
    "id": "move-pack",
    "name": {
      "en": "move-pack",
      "hi": "निर्माता संग्रह"
    },
    "version": 1,
    "author": "ai",
    "createdWith": "codex",
    "notes": "Original geometry and code; no external assets."
  },
  "items": [
    {
      "id": "preset-move",
      "name": {
        "en": "Original preset-move",
        "hi": "मौलिक preset-move"
      },
      "tags": ["original"],
      "type": "preset",
      "data": {
        "appliesTo": ["any"],
        "controls": [
          {
            "name": "angle",
            "label": {
              "en": "Direction",
              "hi": "दिशा"
            },
            "type": "angle",
            "default": 0,
            "min": -180,
            "max": 180,
            "step": 1
          },
          {
            "name": "distance",
            "label": {
              "en": "Distance",
              "hi": "दूरी"
            },
            "type": "number",
            "default": 0.25,
            "min": 0,
            "max": 1,
            "step": 0.1
          }
        ],
        "tracks": [
          {
            "property": "position.x",
            "keys": [
              {
                "t": 0,
                "v": 0
              },
              {
                "t": 1,
                "v": "0/0+$distance+$angle"
              }
            ]
          },
          {
            "property": "position.y",
            "keys": [
              {
                "t": 0,
                "v": 0
              },
              {
                "t": 1,
                "v": "sin($angle*PI/180)*$distance*H"
              }
            ]
          }
        ]
      }
    }
  ]
}
