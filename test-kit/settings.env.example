# SETTINGS FILE FOR THE OWNER'S TEST (copy this file, name the copy: settings.env)
# Rules: one setting per line, NAME=value, no spaces around the = sign,
# no quote marks. Lines that start with # are notes and are ignored.
# settings.env is never uploaded to GitHub. Never share it with anyone.

# ---------- 1. Needed always ----------
# Any long text you invent (30+ letters, numbers, no spaces). Two different ones.
LOCAL_AUTH_SECRET=change-me-to-a-long-invented-text-0001
MCP_SECRET=change-me-to-another-long-invented-text-0002

# Where the programs talk to each other. Do not change.
VITE_GATEWAY_URL=http://127.0.0.1:4400
SERVER_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MCP_PANEL_URL=http://127.0.0.1:5173

# ---------- 2. Admin (Owner App) account ----------
# Used only by 5-CREATE-ADMIN-ACCOUNT.bat (once). Pick your own strong password.
OWNER_PASSWORD=change-me-to-your-admin-password

# ---------- 3. Local test mode (no Supabase) ----------
# For the first round (Part A) this line is ON. When you switch to Supabase (section 4),
# put a # in front of it.
LOCAL_TOKENS=1
AUTH_MODE=local

# ---------- 4. Supabase mode (real accounts) ----------
# For the second round. Fill these from your Supabase project, then remove the # from each line.
# AUTH_MODE=supabase   (also put a # in front of AUTH_MODE=local above)
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=paste-the-secret-key-here
# SUPABASE_JWKS_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json
# Use the JWKS line above. Only if the guide tells you (the JWKS page shows an empty list),
# use this one instead of it:
# SUPABASE_JWT_SECRET=paste-the-legacy-jwt-secret-here
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=paste-the-publishable-key-here

# ---------- 5. Claude connector test (Part 10) ----------
# Paste the address that 6-START-TUNNEL.bat shows, WITHOUT a slash at the end.
# MCP_PUBLIC_URL=https://xxxx-xxxx.trycloudflare.com
