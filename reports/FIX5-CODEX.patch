diff --git a/tests/fix5/media-dispose.test.ts b/tests/fix5/media-dispose.test.ts
new file mode 100644
index 0000000..7a2caf8
--- /dev/null
+++ b/tests/fix5/media-dispose.test.ts
@@ -0,0 +1,60 @@
+import { expect, it, vi } from 'vitest';
+import { MediaFrames } from '../../src/media/frames';
+import { MemoryMediaStore } from '../../src/media/store';
+import type { MediaFrameRequest } from '../../src/render/adapter';
+it('[MED-006] ignores a late image decode after disposing the media provider', async () => {
+  let decoded!: () => void;
+  class FakeImage {
+    src = '';
+    decode() {
+      return new Promise<void>((resolve) => {
+        decoded = resolve;
+      });
+    }
+  }
+  vi.stubGlobal('Image', FakeImage);
+  vi.stubGlobal('HTMLImageElement', FakeImage);
+  try {
+    const key = 'media/' + 'a'.repeat(32);
+    const store = new MemoryMediaStore();
+    await store.write(key, new Blob(['image'], { type: 'image/png' }));
+    let loaded!: () => void;
+    const ready = new Promise<void>((resolve) => {
+      loaded = resolve;
+    });
+    const changed = vi.fn(() => loaded());
+    const frames = new MediaFrames(
+      Promise.resolve(store),
+      () => [
+        {
+          id: 'a',
+          type: 'image',
+          source: { kind: 'local', reference: key },
+          metadata: {},
+        },
+      ],
+      changed,
+    );
+    const request: MediaFrameRequest = {
+      key: 'layer',
+      assetId: 'a',
+      kind: 'image',
+      sourceTime: 0,
+      speed: 1,
+      reversed: false,
+      frozen: false,
+    };
+    frames.frame(request, false);
+    await ready;
+    frames.frame(request, false);
+    expect(decoded).toBeTypeOf('function');
+    changed.mockClear();
+    frames.dispose();
+    decoded();
+    await Promise.resolve();
+    expect(changed).not.toHaveBeenCalled();
+    expect(frames.frame(request, false)).toBeNull();
+  } finally {
+    vi.unstubAllGlobals();
+  }
+});
diff --git a/tests/fix5/processed-cache.test.ts b/tests/fix5/processed-cache.test.ts
new file mode 100644
index 0000000..2a25d5b
--- /dev/null
+++ b/tests/fix5/processed-cache.test.ts
@@ -0,0 +1,28 @@
+import { expect, it } from 'vitest';
+import {
+  createProcessedCache,
+  frameIdentity,
+} from '../../src/render/processed-cache';
+it('[FX-015] reuses processed pixels and bounds retained preview memory without stale frame identities', () => {
+  const released: Uint8ClampedArray[] = [];
+  const cache = createProcessedCache<Uint8ClampedArray>(8, (value) =>
+    released.push(value),
+  );
+  const first = new Uint8ClampedArray([0, 255, 0, 128]);
+  const second = new Uint8ClampedArray([255, 0, 0, 255]);
+  cache.set('clip@0:mask+chroma', first, 4);
+  expect(cache.get('clip@0:mask+chroma')).toBe(first);
+  expect(cache.get('clip@1:mask+chroma')).toBeUndefined();
+  cache.set('second', second, 4);
+  cache.get('clip@0:mask+chroma');
+  cache.set('changed', second.slice(), 4);
+  expect(cache.get('second')).toBeUndefined();
+  expect(cache.bytes).toBe(8);
+  expect(released).toEqual([second]);
+  expect(cache.set('oversized', first, 9)).toBe(false);
+  expect(cache.get('clip@0:mask+chroma')).toEqual(first);
+  expect(frameIdentity(first)).toBe(frameIdentity(first));
+  expect(frameIdentity(second)).not.toBe(frameIdentity(first));
+  cache.clear();
+  expect(cache.bytes).toBe(0);
+});
