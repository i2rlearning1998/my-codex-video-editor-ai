{
  "name": "ai-native-video-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pack:check": "node scripts/pack-check.mjs",
    "composition:build": "node scripts/composition-build.mjs",
    "dev": "vite --host 127.0.0.1",
    "fx:gallery": "vite --config fx-gallery/vite.config.ts",
    "ai-spec:check": "vitest run tests/ai-spec",
    "blocks:gallery": "vite --config blocks-gallery/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && node scripts/assert-editor-bundle.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "ledger": "node scripts/ledger-check.mjs",
    "patch": "node scripts/make-review-patch.mjs",
    "library": "node scripts/build-library.mjs",
    "verify": "npm run check && npm run e2e && node scripts/assert-no-test-hook.mjs && npm run ledger -- --report e2e-results/results.json",
    "freecode:gallery": "vite --config freecode-gallery/vite.config.ts",
    "models:pin": "node scripts/models-pin.mjs",
    "docs:plan-cheatsheet": "node scripts/plan-cheatsheet.mjs",
    "cloud:start": "npx --yes supabase@2.122.0 start",
    "cloud:stop": "npx --yes supabase@2.122.0 stop",
    "cloud:test": "node scripts/cloud-sql-test.mjs",
    "library:keys": "node owner/run.mjs /owner/cli.ts keys",
    "library:seed": "node owner/run.mjs /owner/cli.ts seed",
    "library:publish": "node owner/run.mjs /owner/cli.ts publish",
    "library:rollback": "node owner/run.mjs /owner/cli.ts rollback",
    "library:versions": "node owner/run.mjs /owner/cli.ts versions",
    "owner": "node owner/run.mjs /owner/server/main.ts serve",
    "owner:create": "node owner/run.mjs /owner/server/main.ts create-owner"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@supabase/supabase-js": "2.117.3",
    "mediabunny": "1.59.1",
    "polygon-clipping": "0.15.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.6.0",
    "npm": ">=10.0.0"
  }
}
